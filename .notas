docker compose exec juridica_db_scspr psql -U usr_juridica_scspr -d db_juridica -c "DELETE FROM audit_logs WHERE juicio_id = 999; DELETE FROM juicios WHERE id = 999;"
docker compose exec db_master psql -U usr_global_users -d db_global_users -c "delete FROM usuarios where activo = FALSE"

