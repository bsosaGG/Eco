### 2. BACKEND: Permisos Dinámicos (`api/src/middleware/auth.middleware.js`)

Modifica la función `checkPermission` para que, si recibe un permiso con el prefijo `CONTEXT:`, reemplace ese prefijo dinámicamente usando el valor de `req.appTipo` inyectado en el paso anterior. Debe seguir funcionando perfectamente con los strings estáticos del resto del sistema:

```javascript
const checkPermission = (requiredPermission) => {
  return async (req, res, next) => {
    const { userId, role } = req.user;

    if (role === "admin") {
      return next();
    }

    // RESOLUCIÓN DINÁMICA DE CONTEXTO
    let permissionToQuery = requiredPermission;
    if (requiredPermission.startsWith("CONTEXT:")) {
      const action = requiredPermission.split(":")[1]; // 'create', 'read', 'config'
      // Si req.appTipo es 'impresiones', el permiso final será 'impresiones:create'
      permissionToQuery = `${req.appTipo}:${action}`;
    }

    try {
      const permissionQuery = `
        SELECT 1
        FROM permisos p
        WHERE p.clave_permiso = $1 AND (
            EXISTS (SELECT 1 FROM usuario_permisos up WHERE up.id_usuario = $2 AND up.id_permiso = p.id_permiso) OR
            EXISTS (SELECT 1 FROM usuario_perfiles upf JOIN perfil_permisos pp ON upf.id_perfil = pp.id_perfil WHERE upf.id_usuario = $2 AND pp.id_permiso = p.id_permiso)
        ) LIMIT 1;
      `;

      const { rows } = await db.query(permissionQuery, [permissionToQuery, userId]);

      if (rows.length > 0) {
        return next();
      } else {
        return res.status(403).json({ message: `Acceso denegado. Requiere el permiso [${permissionToQuery}].` });
      }
    } catch (error) {
      console.error("Error al verificar permisos:", error);
      return res.status(500).json({ message: "Error interno al verificar permisos." });
    }
  };
};

```

